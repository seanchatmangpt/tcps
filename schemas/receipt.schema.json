{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tcps:schema:receipt:v1",
  "title": "TCPS Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "previous", "subject", "authority", "intent", "consequence", "verification", "receipt_id"],
  "properties": {
    "schema": {"const": "tcps.receipt.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous": {"type": ["string", "null"]},
    "subject": {"type": "string"},
    "authority": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "intent": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "consequence": {"type": "object"},
    "verification": {"type": "object", "required": ["ok", "kind"]},
    "receipt_id": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"}
  }
}
